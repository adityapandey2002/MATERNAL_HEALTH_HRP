<?xml version="1.0" encoding="utf-8"?>
<!--
  Patient records live in the WebView's IndexedDB. Nothing about this app may
  leave the device through cloud backup or a phone-to-phone transfer: a copy of
  the database on a second device cannot be wiped by the district.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
