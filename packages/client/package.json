{
  "name": "@hrp/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:fast": "tsc --noEmit && biome check --error-on-warnings .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:bundle": "size-limit",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "android:debug": "npm run cap:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/network": "^6.0.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@hrp/shared": "*",
    "@tanstack/react-query": "^5.56.0",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.7",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@playwright/test": "^1.47.0",
    "@size-limit/preset-app": "^11.1.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vite-pwa/assets-generator": "^0.2.6",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.0",
    "autoprefixer": "^10.6.1",
    "dexie-react-hooks": "^4.4.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.31",
    "size-limit": "^11.1.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.0",
    "workbox-window": "^7.1.0",
    "y-dexie": "^4.4.0",
    "yjs": "^13.6.33"
  },
  "size-limit": [
    {
      "path": "dist/assets/index-*.js",
      "limit": "170 kB",
      "gzip": true
    }
  ]
}
