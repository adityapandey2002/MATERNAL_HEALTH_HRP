{
  "name": "@hrp/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check:fast": "tsc --noEmit && biome check --error-on-warnings .",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "fastify": "4.28.1",
    "fastify-cors": "6.1.0",
    "fastify-jwt": "8.0.1",
    "fastify-zod": "1.4.0",
    "zod": "3.23.8",
    "pg": "8.12.0",
    "kysely": "0.27.3",
    "bcryptjs": "2.4.3",
    "@hrp/shared": "*",
    "date-fns": "3.6.0"
  },
  "devDependencies": {
    "@types/node": "22.1.0",
    "@types/pg": "8.11.6",
    "@types/bcryptjs": "2.4.6",
    "typescript": "5.5.4",
    "tsx": "4.16.5",
    "vitest": "2.0.5",
    "@vitest/coverage-v8": "2.0.5",
    "biome": "1.8.3",
    "testcontainers": "10.12.0"
  }
}