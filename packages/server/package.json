{
  "name": "@hrp/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check:fast": "tsc --noEmit && biome check --error-on-warnings .",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@hrp/shared": "*",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "fastify": "^4.28.1",
    "kysely": "^0.27.3",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/fastify-cors": "^0.1.0",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.6",
    "@vitest/coverage-v8": "^2.1.0",
    "testcontainers": "^10.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
