{
  "name": "hrp-tracking-platform",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:client": "npm run dev --workspace=packages/client",
    "dev:server": "npm run dev --workspace=packages/server",
    "build": "npm run build --workspaces --if-present",
    "precheck:fast": "npm run build --workspace=packages/shared",
    "check:fast": "node scripts/check-retired-identifiers.mjs && node scripts/check-shared-exports.mjs && biome check --error-on-warnings scripts && npm run check:fast --workspaces --if-present && npm run security:secrets",
    "precheck:task": "npm run build --workspace=packages/shared",
    "check:task": "npm run check:fast && npm run coverage && npm run check:changed-coverage",
    "precheck:full": "npm run build --workspace=packages/shared",
    "check:full": "npm run check:task && npm run security:secrets && npm run security:semgrep && npm run security:osv",
    "coverage": "npm run coverage --workspaces --if-present",
    "check:changed-coverage": "node scripts/check-changed-coverage.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:semgrep": "node scripts/run-security-tool.mjs semgrep scan --config p/default --config p/owasp-top-ten --error",
    "security:osv": "node scripts/run-security-tool.mjs osv-scanner scan source -r . --config osv-scanner.toml",
    "check:perf": "npm run check:perf --workspaces --if-present",
    "check:a11y": "npm run check:a11y --workspaces --if-present",
    "check:bundle": "npm run check:bundle --workspaces --if-present",
    "pretest": "npm run build --workspace=packages/shared",
    "test": "npm run test --workspaces --if-present",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:smoke:proxy": "node scripts/smoke-test.mjs --via-proxy",
    "test:e2e": "npm run test:e2e --workspace=packages/client",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace=packages/server",
    "db:seed": "npm run db:seed --workspace=packages/server",
    "backup:verify": "node scripts/verify-backup.mjs"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.9.1",
    "@biomejs/biome": "^1.9.0",
    "@vitest/coverage-v8": "^2.1.0",
    "jsdom": "^25.0.1",
    "lighthouse": "^12.1.0",
    "size-limit": "^11.1.6",
    "typescript": "^5.6.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.1"
}
